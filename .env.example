# Public frontend configuration (Vite). Values are exposed to the browser.
# Copy to .env.local for local development. Never put private keys here.

# ── Application ─────────────────────────────────────────────────────────────
VITE_APP_NAME=KingdomDash
VITE_APP_URL=https://kingdomdash.net

# Supabase public credentials only.
VITE_SUPABASE_URL=your-supabase-url # Public — safe in browser, required by Vite
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key# Public — safe in browser, required by Vite

# Supabase server-side credentials — used only by CLI tooling and server functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # SERVER-SIDE ONLY. Never use VITE_ prefix. Never commit real value.
SUPABASE_DB_PASSWORD=your-db-password # SERVER-SIDE ONLY. Never use VITE_ prefix. Never commit real value.

# Official website support / contact phone number (international E.164 format)
VITE_OFFICIAL_PHONE_NUMBER=+2348077958755

# WhatsApp support / fallback channel (international format)
VITE_WHATSAPP_BUSINESS_NUMBER=+2348077958755

# Paystack public key only. The secret key is server-side and must never use the VITE_ prefix.
VITE_PAYSTACK_PUBLIC_KEY=

# Google Maps JavaScript API Key (Optional — fallback layer used if absent)
VITE_GOOGLE_MAPS_API_KEY=

# ── Google OAuth (Sign in with Google) ──────────────────────────────────────
# Google Sign-In is configured in the Supabase Auth dashboard and Google Cloud
# Console. NO frontend environment variable is required for Google OAuth.
#
# To enable Google Sign-In:
# 1. Google Cloud Console  → Create an OAuth 2.0 Client (Web application)
#    Authorized JavaScript origins:  https://kingdomdash.net
#                                    http://localhost:5173 (dev)
#    Authorized redirect URIs:       https://<project-ref>.supabase.co/auth/v1/callback
#
# 2. Supabase Dashboard → Authentication → Providers → Google
#    Enable Google provider
#    Paste your Google Client ID and Google Client Secret
#    Add https://kingdomdash.net/auth/callback to "Redirect URLs"
#    Add http://localhost:5173/auth/callback to "Redirect URLs" (dev)
#
# The frontend only calls supabase.auth.signInWithOAuth({ provider: 'google' }).
# No Google client secrets should ever appear in this file or any VITE_ variable.
